    "sameAvailabilityDateRule": "latest_report_date_only",
    "lateRestatementRule": "skip_non_advancing_report_date",
    "maximumSignalAgeTradingDays": 130,
    "requireAllCandidatesWithinFamily": true,
    "requireAllFamiliesInPrimary": true,
    "liquidityNeutraliseBins": 5
  },
  "families": {
    "earnings_innovation": {
      "economicMechanism": "Unexpected or accelerating profitability disclosed by the issuer can update cash-flow expectations before slow-moving portfolios fully rebalance.",
      "candidates": [
        {"id": "reported_net_profit_growth", "transform": "level", "field": "netProfitYoyPct", "scale": 50.0, "orientation": 1.0},
        {"id": "net_profit_growth_acceleration", "transform": "change_from_prior_disclosed_report", "field": "netProfitYoyPct", "scale": 30.0, "orientation": 1.0},
        {"id": "eps_yoy_innovation", "transform": "same_fiscal_period_symmetric_yoy", "field": "epsYtd", "scale": 1.0, "orientation": 1.0},
        {"id": "parent_profit_yoy_innovation", "transform": "same_fiscal_period_symmetric_yoy", "field": "parentNetProfitYtd", "scale": 1.0, "orientation": 1.0}
      ]
    },
    "growth_acceleration": {
      "economicMechanism": "Revenue and operating-efficiency acceleration can reveal demand inflections that are not reducible to recent price action.",
      "candidates": [
        {"id": "reported_revenue_growth", "transform": "level", "field": "revenueYoyPct", "scale": 30.0, "orientation": 1.0},
        {"id": "revenue_growth_acceleration", "transform": "change_from_prior_disclosed_report", "field": "revenueYoyPct", "scale": 20.0, "orientation": 1.0},
        {"id": "revenue_ytd_yoy_innovation", "transform": "same_fiscal_period_symmetric_yoy", "field": "revenueYtd", "scale": 1.0, "orientation": 1.0},
        {"id": "asset_turnover_acceleration", "transform": "change_from_prior_disclosed_report", "field": "totalAssetTurnover", "scale": 50.0, "orientation": 1.0}
      ]
    },
    "quality": {
      "economicMechanism": "Persistent profitability and capital efficiency can proxy for durable competitive advantage and lower fundamental fragility.",
      "candidates": [
        {"id": "return_on_equity", "transform": "level", "field": "roePct", "scale": 15.0, "orientation": 1.0},
        {"id": "return_on_invested_capital", "transform": "level", "field": "roicPct", "scale": 20.0, "orientation": 1.0},
        {"id": "gross_margin", "transform": "level", "field": "grossMarginPct", "scale": 30.0, "orientation": 1.0},
        {"id": "net_margin", "transform": "level", "field": "netMarginPct", "scale": 10.0, "orientation": 1.0}
      ]
    },
    "cash_flow_quality": {
      "economicMechanism": "Cash conversion distinguishes reported accounting profit from earnings supported by operating cash generation.",
      "candidates": [
        {"id": "operating_cash_to_profit", "transform": "level", "field": "operatingCashToNetProfit", "scale": 1.0, "orientation": 1.0},
        {"id": "operating_cash_to_revenue", "transform": "level", "field": "operatingCashToRevenue", "scale": 0.15, "orientation": 1.0},
        {"id": "cash_to_profit_improvement", "transform": "change_from_prior_disclosed_report", "field": "operatingCashToNetProfit", "scale": 0.5, "orientation": 1.0},
        {"id": "cash_margin_gap", "transform": "cash_margin_minus_net_margin", "field": "operatingCashToRevenue", "otherField": "netMarginPct", "otherScale": 0.01, "scale": 0.10, "orientation": 1.0}
      ]
    }
  },
  "evaluation": {
    "signalTimestamp": "safe_disclosure_session_close",
    "entryTimestamp": "next_buyable_open",
    "holdingTradingDays": 20,
    "roundTripCost": 0.003,
    "topFraction": 0.10,
    "minimumCrossSection": 50,
