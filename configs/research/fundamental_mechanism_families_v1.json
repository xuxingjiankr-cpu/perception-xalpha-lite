  "hypothesis": {
    "primaryPolicy": "equal_weight_within_family_then_equal_weight_across_four_families",
    "historicalFactorSelectionAllowedInPrimary": false,
    "historicalWeightFittingAllowed": false,
    "priceVolumeInputsAllowed": false,
