  "purpose": "Evaluate four economically distinct point-in-time fundamental mechanism families without price-volume timing, historical factor selection, or fitted family weights; freeze an equal-family forward shadow record.",
  "preregisteredAt": "2026-08-09T17:30:00+09:00",
  "baseResearchConfig": "configs/research/perception_xalpha_all_ashares_v10_pit_adjusted.json",
