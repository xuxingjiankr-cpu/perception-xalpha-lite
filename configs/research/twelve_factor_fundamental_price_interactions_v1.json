  "hypothesis": {
    "baseline": "current_complete_twelve_factor_multivariate_forecast",
    "primaryCandidate": "same_twelve_factors_plus_all_four_preregistered_interaction_ranks",
    "rankingHeldFixed": "current_guarded_twelve_factor_score",
    "interactionFormula": "cross_section_rank_sqrt_fundamental_family_rank_times_market_context_rank",
    "interactions": {
      "earnings_volume_confirmation": {
        "fundamentalFamily": "earnings_innovation",
        "marketContext": "amount_surprise_20",
        "mechanism": "A newly disclosed earnings improvement is more informative when same-session trading activity confirms that investors noticed it."
      },
      "growth_momentum_confirmation": {
        "fundamentalFamily": "growth_acceleration",
        "marketContext": "momentum_20",
        "mechanism": "Growth acceleration combined with positive medium-horizon price diffusion is a constrained post-announcement-drift hypothesis."
      },
      "quality_low_volatility": {
        "fundamentalFamily": "quality",
        "marketContext": "low_volatility_20",
        "mechanism": "High operating quality with low realised volatility may distinguish durable quality from speculative quality."
      },
      "cash_quality_reversal": {
        "fundamentalFamily": "cash_flow_quality",
        "marketContext": "reversal_5",
        "mechanism": "Cash-supported profitability after a short price drawdown is a constrained quality-at-temporary-discount hypothesis."
      }
    },
    "historicalOutcomeMaySelectInteraction": false,
    "historicalOutcomeMayFitInteractionWeight": false,
    "hyperparameterSearchAllowed": false,
    "historicalRunCanPromote": false
  },
  "marketContexts": {
    "amount_surprise_20": {
      "definition": "log_amount_t_minus_log_median_amount_t_minus_20_to_t_minus_1",
      "lookbackTradingDays": 20,
      "minimumObservations": 15,
      "includesSignalDateAmount": true,
      "denominatorEndsAtPreviousSession": true
    },
    "momentum_20": {
      "definition": "close_t_div_close_t_minus_20_minus_1",
      "lookbackTradingDays": 20
    },
    "low_volatility_20": {
      "definition": "negative_std_of_close_returns_t_minus_19_to_t",
      "lookbackTradingDays": 20
    },
    "reversal_5": {
      "definition": "negative_close_t_div_close_t_minus_5_minus_1",
      "lookbackTradingDays": 5
    }
  },
