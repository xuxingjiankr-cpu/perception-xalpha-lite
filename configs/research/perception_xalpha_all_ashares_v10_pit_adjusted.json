{
  "schemaVersion": "perception_xalpha_autonomous_v2",
  "status": "research_only_shadow_only_not_trading",
  "purpose": "Continuously evolve causal all-A-share factors on the isolated PIT membership, backward-adjusted SH/SZ panel. Historical results cannot promote or connect to trading.",
  "basePerceptionConfig": "configs/research/perception_xalpha_mvp.json",
  "baseCogAlphaConfig": "configs/research/cogalpha_autonomous_v1.json",
  "discoveryObjective": {
    "mode": "gross_predictive",
    "targetCredibleFactorsPerCycle": 5,
    "costMetricsRemainMandatory": true,
    "candidateTier": "counter_placebo_purged_walk_forward_and_pbo_passed_before_project_dsr",
    "credibleTier": "candidate_tier_plus_project_multiple_testing_dsr",
    "neverForceTargetCount": true
  },
  "assetUniverse": {
    "kind": "all_a_shares_pit_adjusted",
    "definition": "historical_SH_SZ_A_shares_including_delisted_since_2019_with_pit_ST_and_trading_status",
    "exchanges": ["SH", "SZ"],
    "masterPath": "data/market/ashare_research/baostock_pit_adjusted/master/ashare_pit_master_latest.jsonl",
    "barsRoot": "data/market/ashare_research/baostock_pit_adjusted/bars_1d_backward_adjusted",
    "pointInTimeMembershipAvailable": true,
    "requireAdjustedPrices": true,
    "requirePointInTimeStatus": true,
    "requirePointInTimeMaster": true,
    "failClosedUnlessUnbiasedHistoricalValidationEligible": true,
    "minimumMasterCoverageForHistoricalValidation": 0.98,
    "minimumEligibleSymbols": 3000,
    "maximumSuspensionFraction": 0.2,
    "maximumMissingBarFraction": 0.15,
    "maximumAbsoluteRawDailyReturn": 0.5,
    "maximumExtremeReturnFraction": 0.005,
    "dataOverrides": {
      "minimumObservationsPerSymbol": 500,
      "minimumMedianDailyAmountCny": 30000000,
      "minimumCrossSection": 300
    },
    "fundamentalData": {
      "root": "data/market/ashare_research/fundamentals_pit",
      "provider": "akshare_eastmoney_financial_analysis_indicator",
      "availabilityRule": "first_market_date_strictly_after_max_notice_update",
      "minimumSymbolCoverage": 0.60,
      "minimumLatestFeatureCoverage": 0.35,
      "coreFields": ["fund_roe", "fund_book_to_price", "fund_revenue_yoy"],
      "fields": [
        "fund_eps_ytd",
        "fund_book_value_per_share",
        "fund_revenue_yoy",
        "fund_net_profit_yoy",
        "fund_roe",
        "fund_roic",
        "fund_gross_margin",
        "fund_net_margin",
        "fund_debt_asset_ratio",
        "fund_current_ratio",
        "fund_quick_ratio",
        "fund_cash_to_revenue",
        "fund_cash_to_profit",
        "fund_receivable_turnover_days",
        "fund_inventory_turnover_days",
        "fund_total_asset_turnover",
        "fund_book_to_price",
        "fund_annualized_earnings_yield",
        "fund_quality_composite",
        "fund_growth_composite",
        "fund_balance_sheet_safety",
        "fund_accrual_quality"
      ]
    },
    "survivorshipWarning": "SH/SZ membership includes listings and delistings whose lifetime overlaps 2019 onward. Historical ST and trading status are enforced per bar. BJ is excluded because equivalent PIT status coverage is unavailable."
  },
  "researchDirector": {
    "maximumQuestionsPerCycle": 7,
    "maximumMechanismsPerPhenomenon": 2,
    "priority": ["market_mechanism", "historical_train_feedback", "novelty", "recurrence"],
    "validationFeedbackAllowed": false,
    "shadowFeedbackAllowed": false
  },
  "mechanismLibrary": {
    "archetypes": [
      "order_splitting",
      "liquidity_reversal",
      "risk_budgeting",
      "information_diffusion",
      "crowding_unwind",
      "benchmark_rebalancing",
      "volatility_feedback"
    ],
    "requiredBundleMembers": ["primary", "counter", "placebo"],
    "failureConditionsRequired": true
  },
  "synthesis": {
    "provider": "deterministic_local_grammar",
    "remoteApiAllowed": false,
    "arbitraryPythonAllowed": false,
    "structuredSeedLibrary": "a_share_fundamental_pit_v1",
    "maximumStructuredSeedsPerQuestion": 12,
    "maximumPrimaryCandidatesPerCycle": 256,
    "maximumStage2Bundles": 24,
    "initialVariantsPerQuestion": 8,
    "generationsPerCycle": 8,
    "parentPoolSize": 24,
    "childrenPerParent": 4,
    "maximumPersistentParents": 20,
    "maximumExpressionDepth": 9,
    "placeboLagTradingDays": 20,
    "operators": ["mutation", "crossover", "refinement", "novelty_injection"],
    "operatorWeights": {
      "mutation": 0.35,
      "crossover": 0.20,
      "refinement": 0.25,
      "novelty_injection": 0.20
    },
    "randomSeed": 20260803,
    "seedParentsFromBestScreened": true,
    "minimumParentsToContinue": 8
  },
  "fastScreen": {
    "selectionData": "train_only",
    "minimumTrainIcDays": 120,
    "minimumAbsoluteRankIc": 0.005,
    "minimumRankIcIr": 0.08,
    "minimumGrossLongOnlyIr": 0.0,
    "minimumCostedLongOnlyIr": 0.0,
    "maximumNanFraction": 0.3,
    "minimumMedianCrossSectionDistinct": 5,
    "maximumBehaviorCorrelation": 0.85,
    "complexityPenaltyPerDepth": 0.03,
    "sizeNeutralise": true,
    "sizeNeutraliseBins": 5,
    "bookConstruction": "linear_rank_tilt"
  },
  "fullEvaluation": {
    "selectionData": "purged_train_validation_shadow",
    "roundTripCost": 0.003,
    "maximumLabelHorizonTradingDays": 10,
    "purgedWalkForwardFolds": 5,
    "purgeTradingDays": 10,
    "minimumPositiveWalkForwardFolds": 3,
    "minimumValidationRankIc": 0.005,
    "minimumValidationGrossIr": 0.0,
    "minimumValidationCostedIr": 0.0,
    "minimumPrimaryAdvantageOverCounterIr": 0.0,
    "minimumPrimaryAdvantageOverPlaceboIr": 0.0,
    "pboMaximum": 0.2,
    "priorProjectTrials": 1669,
    "priorProjectTrialsRationale": "1157 preregistered historical trials plus 256 V5 candidates plus 256 candidates from the already-started V4 cycle; completed V10 registry trials are added automatically.",
    "failureConditionTrainQuantile": 0.75,
    "validationOrShadowMetricsReturnedToGenerator": false,
    "historicalRunCanPromote": false,
    "freshForwardDaysRequired": 60,
    "humanApprovalRequired": true
  },
  "evolutionPolicy": {
    "trigger": "new_input_fingerprint_only",
    "parentSelectionData": "train_only",
    "legacyParentMigrationAllowed": false,
    "validationOrShadowFeedbackAllowed": false,
    "parametersFrozenWithinCycle": true,
    "thresholdChangesRequireNewPreregisteredVersion": true,
    "zeroCredibleFactorsIsValid": true
  },
  "registry": {
    "sqlitePath": "outputs/edge_research/perception_xalpha_all_ashares_v10_pit_adjusted/state/perception_xalpha_all_ashares_v10_pit_adjusted.sqlite",
    "outputRoot": "outputs/edge_research/perception_xalpha_all_ashares_v10_pit_adjusted",
    "stateDirectory": "outputs/edge_research/perception_xalpha_all_ashares_v10_pit_adjusted/state",
    "skipWhenDataFingerprintUnchanged": true,
    "cleanRegistryStartsWithoutLegacyParents": true,
    "appendOnlyEntities": [
      "research_cycles",
      "research_plans",
      "mechanism_hypotheses",
      "factor_bundles",
      "experiments",
      "rejection_events",
      "factor_observations"
    ]
  },
  "stateMachine": [
    "DRAFT",
    "STATIC_VALIDATED",
    "LEAKAGE_VALIDATED",
    "FAST_SCREENED",
    "HISTORICALLY_VALIDATED",
    "BORN",
    "SHADOW",
    "REJECTED",
    "RETIRED"
  ],
  "safety": {
    "mayReadTradingConfig": false,
    "mayWriteTradingConfig": false,
    "mayWriteStrategyOverlay": false,
    "mayCallBroker": false,
    "mayCreateOrders": false,
    "mayAlterBuildDecision": false,
    "mayAlterRiskGate": false,
    "mayAlterPositionSizing": false,
    "mayPromoteAutomatically": false,
    "mayConnectToObservationPool": false,
    "mayConnectToTrading": false,
    "outputStatus": "diagnostic_only"
  }
}
