{
  "schemaVersion": "ashare_pit_adjusted_data_v1",
  "status": "research_only_not_trading",
  "purpose": "Build an isolated SH/SZ historical A-share master and backward-adjusted daily panel with listing/delisting dates plus point-in-time ST and trading status. It never overwrites the existing raw TDX/Sina dataset.",
  "provider": {
    "name": "BaoStock",
    "pythonPackage": "baostock",
    "requiredPackageVersion": "0.9.1",
    "priceAdjustmentFlag": "1",
    "priceAdjustmentMeaning": "backward_adjusted_pct_change_method",
    "frequency": "d",
    "fields": [
      "date",
      "code",
      "open",
      "high",
      "low",
      "close",
      "preclose",
      "volume",
      "amount",
      "adjustflag",
      "tradestatus",
      "pctChg",
      "isST"
    ]
  },
  "universe": {
    "exchanges": ["SH", "SZ"],
    "securityType": "1",
    "startDate": "2019-01-01",
    "endDate": "",
    "includeDelistedWhoseOutDateIsOnOrAfterStart": true,
    "pointInTimeMembershipRule": "listing_date_less_equal_t_and_delisting_date_empty_or_t_less_equal_delisting_date",
    "excludeHistoricalSTFromEligibility": true,
    "excludeNonTradingRowsFromEligibility": true,
    "beijingExchangePolicy": "excluded_from_clean_v1_because_baostock_does_not_supply_equivalent_historical_membership_and_isST_coverage"
  },
  "normalization": {
    "volumeUnit": "shares",
    "amountUnit": "CNY",
    "vwapField": "adjusted_ohlc4_proxy",
    "vwapLimitation": "BaoStock amount and volume remain on the raw price scale while adjusted OHLC is on the backward-adjusted scale; use adjusted OHLC4 as an explicit proxy rather than mixing scales.",
    "incrementalPolicy": "backward_adjusted_history_is_append_stable_but_force_refresh_remains_available_for_vendor_corrections",
    "noForwardFill": true
  },
  "qualityGate": {
    "minimumMasterFileCoverage": 0.98,
    "minimumSymbolsWithAtLeast500Rows": 3000,
    "maximumInvalidRowFraction": 0.001,
    "requireAllRowsAdjusted": true,
    "requireAllRowsPointInTimeStatus": true,
    "requireListingDateForEveryMasterRow": true,
    "historicalResearchMayStartOnlyAfterGatePasses": true
  },
  "paths": {
    "masterRoot": "data/market/ashare_research/baostock_pit_adjusted/master",
    "latestMaster": "data/market/ashare_research/baostock_pit_adjusted/master/ashare_pit_master_latest.jsonl",
    "barsRoot": "data/market/ashare_research/baostock_pit_adjusted/bars_1d_backward_adjusted",
    "manifest": "data/market/ashare_research/baostock_pit_adjusted/collection_manifest.jsonl",
    "auditRoot": "outputs/edge_research/ashare_pit_adjusted_data_v1"
  },
  "knownLimitations": [
    "BaoStock v1 covers SH/SZ but not an equivalent clean Beijing Stock Exchange history; BJ is excluded rather than silently mixed with a lower-quality current universe.",
    "Backward adjustment follows BaoStock's percentage-change method and is not a cash-dividend total-return index.",
    "Adjusted OHLC and raw turnover cannot form an exact adjusted VWAP without a raw-price companion series, so the stored vwap is explicitly an OHLC4 proxy.",
    "Provider corrections can revise history; every run records config, master and output hashes and supports a full force refresh.",
    "This data layer improves research validity but does not itself create alpha or guarantee profitability."
  ],
  "safety": {
    "mayReadTradingConfig": false,
    "mayWriteTradingConfig": false,
    "mayWriteStrategyOverlay": false,
    "mayCallBroker": false,
    "mayCreateOrders": false,
    "mayAlterBuildDecision": false,
    "mayAlterRiskGate": false,
    "mayAlterPositionSizing": false,
    "mayPromoteAutomatically": false,
    "mayConnectToTrading": false,
    "outputStatus": "diagnostic_only"
  }
}
