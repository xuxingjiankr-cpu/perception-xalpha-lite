{
  "schemaVersion": "perception_xalpha_winrate_tail_v3",
  "status": "research_only_shadow_only_not_trading",
  "purpose": "Test whether a separately trained downside-tail head can prevent infrequent large losses from overwhelming the positive hit rate of the rolling cross-sectional stock ranker.",
  "baseWinrateConfig": "configs/research/perception_xalpha_winrate_v2.json",
  "preregisteredHypothesis": {
    "economicRationale": "V2 achieved a shadow win rate above fifty percent but negative expectancy, implying loss severity rather than hit count is the unresolved failure. Penalising predicted ten-day tail-loss probability should improve both win rate and payoff asymmetry.",
    "primaryPolicy": "tail_adjusted_top10_adaptive_gate",
    "parametersFrozenBeforeHistoricalRun": true,
    "validationAndShadowMayNotTuneParameters": true,
    "countsAsNewResearchTrial": true
  },
  "data": {
    "holdingTradingDays": 10,
    "candidatePoolSize": 50,
    "maximumSelectionsPerDay": 10,
    "roundTripCost": 0.003,
    "tailLossThreshold": -0.03,
    "signalTiming": "day_t_close_past_only",
    "hypotheticalEntryTiming": "day_t_plus_1_open"
  },
  "tailModel": {
    "kind": "LogisticRegression",
    "C": 0.1,
    "penalty": "l2",
    "solver": "liblinear",
    "classWeight": "balanced",
    "maximumIterations": 1000,
    "trainingWindowTradingDays": 756,
    "minimumTrainingTradingDays": 504,
    "refitEveryTradingDays": 21,
    "purgeTradingDays": 10,
    "missingValuePolicy": "training_median",
    "standardization": "training_only_standard_scaler",
    "randomSeed": 20260803,
    "featureColumns": [
      "x_factor_volatility_asymmetry",
      "x_factor_value_minus_momentum",
      "x_factor_growth_quality_momentum",
      "x_factor_multi_period_reversal",
      "x_factor_composite",
      "x_factor_minimum",
      "x_factor_dispersion",
      "x_stock_return_5",
      "x_stock_return_20",
      "x_stock_return_60",
      "x_stock_volatility_20",
      "x_stock_volatility_60",
      "x_stock_drawdown_60",
      "x_stock_amount_ratio_5_20",
      "x_stock_liquidity_percentile",
      "x_stock_open_gap",
      "x_stock_intraday_return",
      "market_return_20",
      "market_return_60",
      "market_volatility_20",
      "market_breadth_20"
    ]
  },
  "riskAdjustment": {
    "formula": "within_date_percentile_of_rank_prediction_minus_0_5_times_tail_probability",
    "tailProbabilityPenalty": 0.5,
    "adaptiveGate": "selected_mean_tail_probability_not_above_training_tail_base_rate",
    "adaptiveGateMultiplier": 1.0,
    "allowCash": true,
    "neverForceTenSelections": true
  },
  "policies": [
    "frozen_factor_top10_all_days",
    "rolling_ridge_rank_top10_all_days",
    "tail_adjusted_top10_all_days",
    "tail_adjusted_top10_adaptive_gate"
  ],
  "evaluation": {
    "primaryMetric": "basket_ten_day_mean_return",
    "secondaryMetrics": [
      "basket_ten_day_win_rate",
      "tail_loss_rate",
      "average_loser_return",
      "ten_percent_expected_shortfall",
      "costed_cumulative_return",
      "maximum_drawdown",
      "coverage",
      "independent_event_count"
    ],
    "hacLagTradingDays": 10,
    "minimumSignalDaysPerValidationPeriod": 25,
    "minimumIndependentEventsPerValidationPeriod": 8,
    "minimumWinRateLiftVsFactorTop10": 0.05,
    "minimumTailLossRateReductionVsRankTop10": 0.05,
    "minimumHacTForSameDayReturnDifference": 1.65,
    "requirePositiveBasketMeanReturn": true,
    "requirePositiveCostedCumulativeReturn": true,
    "mustPassValidationAndShadow": true,
    "historicalRunCanPromote": false
  },
  "knownLimitations": [
    "This is the second post-V1 win-rate hypothesis and the reused validation/shadow windows are not a pristine holdout.",
    "Tail-event class balancing changes model fitting but not reported natural tail frequencies.",
    "The current security master has incomplete delisted-name and historical-ST coverage.",
    "The A-share research panel still uses raw unadjusted prices."
  ],
  "output": {
    "root": "outputs/edge_research/perception_xalpha_winrate_tail_v3",
    "ordersAlwaysEmpty": true
  },
  "safety": {
    "mayReadTradingConfig": false,
    "mayWriteTradingConfig": false,
    "mayWriteStrategyOverlay": false,
    "mayCallBroker": false,
    "mayCreateOrders": false,
    "mayAlterBuildDecision": false,
    "mayAlterRiskGate": false,
    "mayAlterPositionSizing": false,
    "mayPromoteAutomatically": false,
    "mayConnectToTrading": false,
    "outputStatus": "diagnostic_only"
  }
}
