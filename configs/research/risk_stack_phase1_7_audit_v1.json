      "role": "short-horizon dynamical instability diagnostics",
      "primaryReference": "Schmid (2010), Dynamic Mode Decomposition of Numerical and Experimental Data"
    },
    "hmm": {
      "role": "regime labeling and transition-risk context",
      "primaryReference": "Hamilton (1989), A New Approach to the Economic Analysis of Nonstationary Time Series and the Business Cycle"
    },
    "hawkes": {
      "role": "self-exciting observable risk-event intensity",
      "primaryReference": "Bacry, Mastromatteo and Muzy (2015), Hawkes Processes in Finance, arXiv:1502.04592"
    },
    "exitPositionLayer": {
      "role": "risk-conditioned exit tightening / position de-risking hypotheses",
