# Safe-by-default repository for the ETF paper-trading agent.
# Everything is ignored unless explicitly whitelisted below.

*

# Repository metadata / docs
!.gitignore
!README.md
!requirements-stock-forecast-dashboard.txt
!docs/
!docs/**
!dashboard/
!dashboard/stock_forecast/
!dashboard/stock_forecast/**
!/*.cmd

# Paper-trading agent source and configs
!configs/
!configs/*.json
# Preregistered research configs are part of the audit trail, not runtime state
!configs/research/
!configs/research/*.json
!scripts/
!scripts/*.py
!scripts/*.ps1
!scripts/*.cmd
# Vendored factor library (HKUDS/Vibe-Trading, MIT; per-zoo LICENSE.md retained)
!scripts/vendor/
!scripts/vendor/**

# Never commit runtime outputs, account state, logs, caches, datasets, or cloned references.
outputs/
data/
_external/
.dotnet/
.skillhub_inspect_*/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.log
**/*.jsonl
**/*.csv
**/*.parquet
**/*.sqlite
**/*.db
**/*.bak*
**/KILL_SWITCH

# Secrets / local environment
.env
.env.*
*.key
*.pem
*.pfx
*.p12
*.crt
*.cer
*.secret
*.token
*.credentials

# Keep downloaded installation docs local unless intentionally sanitized.
htsc-skills-bundle_INSTALL_*.md

# mootdx TDX backfill data (54MB, regenerable via scripts/backfill_mootdx_history.py)
data/market/mootdx/
