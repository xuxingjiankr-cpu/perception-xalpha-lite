    "status": "break_date_not_preregistered",
    "automaticSelectionAllowed": false,
    "candidateDatesAreExploratoryOnly": true,
    "candidateScan": {
      "candidateFrequency": "first_available_trading_day_of_each_month",
      "minimumTradingDaysEachSide": 120,
      "comparisonWindowTradingDaysEachSide": 60,
      "maximumCandidatesReported": 5,
      "score": "mean absolute standardized shift across daily return, realized volatility, log amount, log volume, range, 5-bar label rate and 10-bar label rate",
      "profitabilityOrOosMetricsUsed": false
    }
  },
  "gate0": {
    "minimumSymbols": 15,
    "minimumTradingDays": 400,
    "maximumMissingBarFraction": 0.01,
    "maximumInvalidOhlcRows": 0,
    "minimumIndependentTurningEventsPerPrimaryHorizon": 500,
    "minimumAuxiliaryFeatureCoverage": 0.9,
    "breakDateMustBePreregisteredForPostJumpModel": true,
    "modelingAllowedOnlyIfAllRequiredGatesPass": true
  },
  "auxiliaryFeatures": {
    "decisionStrideBars": 5,
    "pastWindowBars": 24,
    "trainingStatisticsEnd": "2025-06-30",
    "winsorizationQuantiles": [
      0.01,
      0.99
    ],
    "noOutcomeDrivenParameterSelection": true,
    "noForcedImputation": true,
    "retainInvalidRowsWithValidityFlags": true,
    "lppls": {
      "source": "fixed classic LPPLS implementation from Phase 2A",
      "features": [
        "lppls_fit_success",
        "lppls_tc_proximity",
        "lppls_time_to_tc",
        "lppls_fit_residual",
        "lppls_parameter_stability",
        "lppls_window_consensus",
        "lppls_bubble_like_score"
      ],
      "parameterStabilityFormula": "exp(-mean(tc_std/12, m_std/0.4, omega_std/4))",
      "windowConsensusFormula": "1 - mean(clipped(tc_std/12, m_std/0.4, omega_std/4), 0, 1)",
      "bubbleLikeFormula": "trend_eligible * exp(-fit_residual) * window_consensus",
      "independentTurningPredictionAllowed": false
    },
    "dmd": {
      "source": "fixed-window linear delay-DMD implementation from Phase 2A",
      "features": [
        "dmd_reconstruction_residual",
        "dmd_residual_zscore",
        "dmd_spectral_radius",
        "dmd_spectral_radius_drift",
        "dmd_eigen_instability",
        "dmd_window_valid",
        "dmd_missing_bar_ratio"
      ],
      "residualZscoreFitEnd": "2025-06-30",
      "spectralRadiusDrift": "current valid radius minus the prior valid same-symbol same-session radius",
      "independentTurningPredictionAllowed": false
    }
  },
  "plannedModels": {
    "enabledAfterGate0Only": true,
    "variants": [
      "constant_prior",
